# Azure Virtual Desktop Web Client — Credentials
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   source .env
#   python3 list_vms.py

# Required: Azure AD / Microsoft 365 credentials
AVD_EMAIL=user@contoso.com
AVD_PASSWORD=your-password-here

# Optional: session persistence (saves cookies + tokens for reuse)
AVD_STORAGE_STATE=~/.avd_session.json

# Optional: run browser visibly instead of headless (for debugging / MFA)
# Set to "false" to see the browser window
AVD_HEADLESS=true

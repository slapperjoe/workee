# Azure Virtual Desktop automation — rename to .env and fill in your values.
# Do NOT commit .env to version control.

# --- Credentials ---
AVD_EMAIL=user@example.com
AVD_PASSWORD=your-password-here

# --- MFA Configuration ---
# Method: "totp" or "manual" or "auto"
#   totp   — uses TOTP secret to generate codes automatically (recommended)
#   manual — prompts for code on stdin each time
#   auto   — tries totp first; falls back to manual if secret not set
AVD_MFA_METHOD=auto

# TOTP secret key (required for totp mode)
# To get this: https://mysignins.microsoft.com/security-info → Add sign-in method →
#   Authenticator app → "I want to use a different authenticator app" →
#   "Can't scan image?" → copy the secret key
AVD_TOTP_SECRET=

# Maximum seconds to wait for MFA prompt to appear (default: 120)
AVD_MFA_TIMEOUT=120

# Maximum seconds to wait after submitting MFA code for login to complete (default: 60)
AVD_MFA_POST_SUBMIT_TIMEOUT=60

# --- QR Code Auth (Australian government compliance — replaces TOTP) ---
# Set AVD_MFA_METHOD=qr to use QR code authentication
# QR signing key: base64-encoded 32-byte HMAC key; auto-generated if empty
AVD_QR_SIGNING_KEY=
# Token lifetime in seconds (default: 300 = 5 minutes, per ISM-1745)
AVD_QR_TOKEN_TTL=300
# Local callback server settings
AVD_QR_CALLBACK_HOST=127.0.0.1
AVD_QR_CALLBACK_PORT=48480
AVD_QR_CALLBACK_PATH=/callback

# --- Session Persistence ---
# Path to save/load browser storage state (cookies, localStorage, tokens)
AVD_STORAGE_STATE_PATH=./auth-state.json

# --- Browser ---
# Set to "true" to show browser window during login (useful for debugging)
AVD_HEADED=false

# --- Session Persistence (avd_session.py) ---
# How often to check whether the session has expired (seconds, default: 15)
AVD_SESSION_POLL_INTERVAL=15

# Maximum time to wait for re-authentication to complete (seconds, default: 300)
AVD_SESSION_REAUTH_TIMEOUT=300

# --- Azure Environment (default: commercial) ---
# Options: commercial, usgov, dod
AVD_ENVIRONMENT=commercial
